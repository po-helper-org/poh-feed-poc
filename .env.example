# Пароль аккаунтов агентов на стенде GoToSocial. Нужен scripts/create_agents.sh
# и scripts/get_tokens.sh (для логина /auth/sign_in). Не хранить в коде —
# только через эту переменную окружения. На уже созданных этим PoC аккаунтах
# стоит пароль PoC-feed-2026! — подставляйте его, если не меняли сознательно.
FEED_ACCOUNT_PASSWORD=

# Токены доступа для агентов ленты. Реальный файл — .env (в .gitignore,
# в репозиторий не попадает). Получаются скриптом scripts/get_tokens.sh
# (документированный OAuth-флоу authorization_code — GoToSocial не
# поддерживает grant_type=password).
FEED_TOKEN_ISSUE_AGENT=
FEED_TOKEN_OPENHANDS=
FEED_TOKEN_PR_AGENT=
FEED_TOKEN_HOWTODEMO=
FEED_TOKEN_DELIVERY=
FEED_TOKEN_HARNESS=

# Токен доступа к GitHub. Мост доставляет решения человека постановкой
# метки на Issue и читает состояние задач — без него он бесполезен.
# Обязателен: без значения bridge.config.Settings.load() отказывает явной
# ошибкой, а не тихо падает где-то посреди обхода.
GITHUB_TOKEN=

# Репозитории, которые мост обслуживает — имена вида owner/repo через
# запятую, если их несколько. Обязателен и БЕЗ ДЕФОЛТА (итоговый обзор,
# правка №7): раньше дефолтом стоял настоящий рабочий репозиторий
# владельца, и мост, запущенный без настройки, начинал бы писать в него
# метки и комментарии.
BRIDGE_REPOS=

# Путь к файлу SQLite с соответствиями (ветки/опросы/идемпотентность) —
# см. bridge/src/bridge/mapping.py. Необязательна: по умолчанию — bridge.db
# в текущем каталоге запуска.
BRIDGE_DB=

# Пауза между обходами непрерывного режима, в секундах. Необязательна: по
# умолчанию 30 (итоговый обзор, правка №5) — раньше было 5 секунд наугад, и
# при нескольких открытых опросах одновременно частота обращений к GitHub
# API подбиралась вплотную к лимиту 5000 запросов/час. Для ленты, которую
# человек читает глазами, 30 секунд не удлиняют ощутимо ожидание, зато
# держат частоту обращений с большим запасом.
BRIDGE_CYCLE_SECONDS=
