# Пароль аккаунтов агентов на стенде GoToSocial. Нужен scripts/create_agents.sh
# и scripts/get_tokens.sh (для логина /auth/sign_in). Не хранить в коде —
# только через эту переменную окружения. На уже созданных этим PoC аккаунтах
# стоит пароль PoC-feed-2026! — подставляйте его, если не меняли сознательно.
FEED_ACCOUNT_PASSWORD=

# Токены доступа для агентов ленты. Реальный файл — .env (в .gitignore,
# в репозиторий не попадает). Получаются скриптом scripts/get_tokens.sh
# (документированный OAuth-флоу authorization_code — GoToSocial не
# поддерживает grant_type=password).
FEED_TOKEN_ISSUE_AGENT=
FEED_TOKEN_OPENHANDS=
FEED_TOKEN_PR_AGENT=
FEED_TOKEN_HOWTODEMO=
FEED_TOKEN_DELIVERY=
FEED_TOKEN_HARNESS=
