# Образец окружения для PoC ленты контура.
# Рабочий файл — .env, он в .gitignore и в репозиторий не попадает.
#
# Заполнять сверху вниз: токены агентов зависят от заведённых учёток,
# а учётки — от поднятого стенда.
#
#   docker compose up -d
#   FEED_ACCOUNT_PASSWORD='...' ./scripts/create_agents.sh
#   FEED_ACCOUNT_PASSWORD='...' ./scripts/get_tokens.sh
#   ./tests/test_login_e2e.sh
#
# Адреса стенда после настройки:
#   API ленты          http://127.0.0.1:8080
#   лента по TLS       https://feed.localtest.me   (стандартный порт 443)
#   клиент Phanpy      http://127.0.0.1:8083
#   вход               http://127.0.0.1:8083/#/login?instance=feed.localtest.me
#
# Почему именно так — три требования Phanpy, каждое найдено живой поломкой:
#   1. TLS обязателен: регистрацию приложения он делает только по https;
#   2. порт в поле адреса не принимается — инстанс обязан быть на 443;
#   3. домен обязан содержать точку, иначе клиент молча подставляет чужую
#      подсказку из своего списка серверов.
# Имя feed.localtest.me публичный DNS отдаёт как 127.0.0.1 — правка
# /etc/hosts не нужна.
#
# И отдельно: публичный phanpy.social до локального инстанса НЕ достучится.
# Chrome режет запросы с публичного источника на петлю, и заголовками это
# не снимается. Клиент обязан быть локальным.

# --- учётки -----------------------------------------------------------

# Пароль учёток агентов и человека. Нужен scripts/create_agents.sh (заводит)
# и scripts/get_tokens.sh (логинится через /auth/sign_in).
# В коде значения по умолчанию нет намеренно: пароль в репозитории — плохая
# привычка, а здесь она ничего не экономит.
FEED_ACCOUNT_PASSWORD=

# --- токены ленты -----------------------------------------------------

# По одному на агента. Получаются scripts/get_tokens.sh — документированным
# флоу authorization_code: GoToSocial grant_type=password не поддерживает
# вовсе, отвечает unsupported_grant_type.
FEED_TOKEN_ISSUE_AGENT=
FEED_TOKEN_OPENHANDS=
FEED_TOKEN_PR_AGENT=
FEED_TOKEN_HOWTODEMO=
FEED_TOKEN_DELIVERY=
FEED_TOKEN_HARNESS=

# --- связь с обслуживаемой системой -----------------------------------

# Токен GitHub. Мост читает состояние задач и доставляет решения человека
# постановкой метки — без него он бесполезен. Обязателен: без значения
# Settings.load() отказывает явной ошибкой, а не падает посреди обхода.
# Заполнять лучше не руками:
#   echo "GITHUB_TOKEN=$(gh auth token)" >> .env
GITHUB_TOKEN=

# Репозитории через запятую, имена вида owner/repo.
# Обязателен и БЕЗ ДЕФОЛТА: раньше дефолтом стоял настоящий рабочий
# репозиторий владельца, и мост, запущенный без настройки, начинал бы
# писать в него метки и комментарии.
BRIDGE_REPOS=

# --- необязательное ---------------------------------------------------

# Файл SQLite с соответствиями: ветки, опросы, идемпотентность, замер
# простоя. По умолчанию bridge.db в каталоге запуска.
BRIDGE_DB=

# Пауза между обходами непрерывного режима, секунды. По умолчанию 30.
# Прежние 5 секунд были взяты наугад и при нескольких открытых опросах
# подводили частоту обращений вплотную к лимиту GitHub в 5000 запросов
# в час. Для ленты, которую читает человек, 30 секунд ничего не портят.
BRIDGE_CYCLE_SECONDS=
